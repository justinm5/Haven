# Optional: only needed by the older HomePilot pages that use Supabase.
# Get both values from your Supabase project's API settings.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional: public URL of the Haven API when it is not at localhost:8081.
# This value is embedded in the browser build; do not put secrets here.
VITE_HAVEN_API_URL=http://127.0.0.1:8081
