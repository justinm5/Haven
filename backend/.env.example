# Used by: docker compose --env-file backend/.env -f compose.haven.yml up --build
# This database is independent of the existing app's Supabase database.
HAVEN_DB_PASSWORD=
# Generate a unique value, e.g. openssl rand -hex 32. Do not place it in VITE_*.
HAVEN_IMPORT_TOKEN=
# Enable only source identifiers you have permission to ingest.
HAVEN_ALLOWED_SOURCES=manual
HAVEN_WEB_ORIGIN=http://127.0.0.1:5173

# Live rental search: private key from your RentCast account. Never use VITE_ for this.
HAVEN_RENTCAST_API_KEY=
